REDIS_URL=redis://localhost:6379/0
VASTAI_REDIS_URL=  # Redis URL reachable from Vast.ai workers (e.g. rediss://:password@xxx.upstash.io:6379). Falls back to REDIS_URL.
S3_ENDPOINT_URL=https://eu2.contabostorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1
S3_BUCKET_RAW=wismo-raw-files
S3_BUCKET_EXTRACTS=wismo-text-extracts
INTERNAL_SHARED_SECRET=changeme
VPS_CALLBACK_URL=http://127.0.0.1:8000
GPU_DOCKER_IMAGE=ghcr.io/wismo/wismo-gpu-worker:latest
WHISPER_GPU_DOCKER_IMAGE=
EMBEDDING_GPU_DOCKER_IMAGE=
HUGGINGFACE_HUB_TOKEN=
LLM_MODEL_NAME=Qwen/Qwen3-14B
WORKER_MODE=both
VASTAI_API_KEY=
VASTAI_SEARCH_FILTER=verified=true cuda_max_good>=12.1 gpu_ram>=16 reliability>0.98 inet_down>=500 num_gpus=1
VASTAI_LLM_SEARCH_FILTER=verified=true cuda_max_good>=12.1 gpu_ram>=32 reliability>0.98 inet_down>=500 num_gpus=1
VASTAI_LLM_DISK_GB=40
VASTAI_MAX_INSTANCES=2
VASTAI_MAX_HOURLY_COST=0.50
VASTAI_LLM_MAX_HOURLY_COST=0.40
VASTAI_HEALTH_TIMEOUT_SECONDS=30
VASTAI_IDLE_TIMEOUT_MINUTES=15
GPU_TASK_REQUEST_TIMEOUT_SECONDS=120
WORKER_ALERT_THROTTLE_WINDOW_MINUTES=15
